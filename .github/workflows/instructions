**Here’s the ready-to-use code for your drop site (drop date: 4 November 2026).**

### 1. Drop Timer (`components/DropTimer.tsx`)
```tsx
"use client";
import { useEffect, useState } from "react";

export default function DropTimer() {
  const dropDate = new Date("2026-11-04T00:00:00");
  const [time, setTime] = useState({ days: 0, hours: 0, minutes: 0, seconds: 0 });

  useEffect(() => {
    const timer = setInterval(() => {
      const diff = dropDate.getTime() - Date.now();
      if (diff <= 0) {
        setTime({ days: 0, hours: 0, minutes: 0, seconds: 0 });
        return;
      }
      setTime({
        days: Math.floor(diff / (1000 * 60 * 60 * 24)),
        hours: Math.floor((diff / (1000 * 60 * 60)) % 24),
        minutes: Math.floor((diff / (1000 * 60)) % 60),
        seconds: Math.floor((diff / 1000) % 60),
      });
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  return (
    <div className="text-center text-2xl font-bold my-6">
      Drop starts in: {time.days}d {time.hours}h {time.minutes}m {time.seconds}s
    </div>
  );
}
```

### 2. Home page with gallery (`app/page.tsx`)
```tsx
import DropTimer from "@/components/DropTimer";
import ContactForm from "@/components/ContactForm";

const products = [
  { id: 1, name: "Product 1", price: 25, image: "/product1.jpg" },
  { id: 2, name: "Product 2", price: 30, image: "/product2.jpg" },
  { id: 3, name: "Product 3", price: 20, image: "/product3.jpg" },
  { id: 4, name: "Product 4", price: 35, image: "/product4.jpg" },
];

export default function Home() {
  return (
    <main className="max-w-5xl mx-auto p-4">
      <h1 className="text-3xl font-bold text-center">3D Print Drop</h1>
      <DropTimer />
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4 my-8">
        {products.map((p) => (
          <div key={p.id} className="border rounded p-2 text-center">
            <img src={p.image} alt={p.name} className="w-full h-40 object-cover" />
            <h2 className="font-semibold">{p.name}</h2>
            <p>${p.price}</p>
          </div>
        ))}
      </div>
      <ContactForm />
    </main>
  );
}
```

